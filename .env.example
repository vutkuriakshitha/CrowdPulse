DATABASE_URL=sqlite+aiosqlite:///./data/crowdpulse.db
# Production/Docker example:
# DATABASE_URL=postgresql+asyncpg://cp:cp@localhost:5432/crowdpulse
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
# Control-room JWT (true for Telangana police / stadium handover demos)
AUTH_REQUIRED=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Day 21 demo performance
DEMO_FRAME_STRIDE=4
DEMO_MAX_FRAMES=48
YOLO_MODEL_NAME=yolov8n.pt
YOLO_IMGSZ=640
YOLO_CONF=0.22
YOLO_IOU=0.45
WARM_MODELS_ON_STARTUP=false
CORS_ORIGINS=["http://localhost:3000"]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
NEXT_PUBLIC_API_URL=http://localhost:8000
